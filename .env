# ===== MySQL =====
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=cv_rag_db
MYSQL_USER=admin
MYSQL_PASSWORD=123456
MYSQL_PORT=3306

# ===== Redis =====
REDIS_PORT=6379

# ===== Qdrant =====
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ===== MinIO =====
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=cv-raw-files

# ===== Connection strings dùng trong code Python (không dùng trực tiếp trong compose) =====
# MYSQL_CONN=mysql+pymysql://cvrag_app:cvrag_app_pass@localhost:3306/cv_rag_db
MYSQL_CONN=mysql+pymysql://admin:123456@localhost:3306/cv_rag_db
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
MINIO_ENDPOINT=localhost:9000


MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=cv-raw-files
MINIO_SECURE=false

GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
GMAIL_POLL_QUERY=is:unread has:attachment filename:pdf
GMAIL_LABEL_PROCESSED=CV-Processed

CV_FILENAME_PATTERN=^[A-Za-zÀ-ỹ]+_[A-Za-z0-9]+_CV\.pdf$
CV_MIN_FILE_SIZE_BYTES=51200
CV_MAX_FILE_SIZE_BYTES=10485760
CV_MAX_PAGES=10
DEDUPE_MESSAGE_TTL_SECONDS=604800

