#  MySQL 
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=cv_rag_db
MYSQL_USER=admin
MYSQL_PASSWORD=123456
MYSQL_PORT=3306

MYSQL_CONN=mysql+pymysql://admin:123456@localhost:3306/cv_rag_db
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=cv_chunks

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=cv-raw-files
MINIO_SECURE=false

GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
GMAIL_POLL_QUERY=is:unread has:attachment filename:pdf
GMAIL_LABEL_PROCESSED=CV-Processed

CV_FILENAME_PATTERN=^[A-Za-zÀ-ỹ]+_[A-Za-z0-9]+_CV\.pdf$
CV_MIN_FILE_SIZE_BYTES=20480
CV_MAX_FILE_SIZE_BYTES=52428800
CV_MAX_PAGES=10
CV_MIN_TEXT_LENGTH=100
CV_CLASSIFY_MIN_CONFIDENCE=0.6
DEDUPE_MESSAGE_TTL_SECONDS=604800

# Gemini API Keys (Hỗ trợ xoay vòng failover khi gặp lỗi 429 quota limit)
GOOGLE_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
GEMINI_LLM_MODEL=gemini-3.5-flash
GEMINI_CLASSIFY_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Rerank — cross-encoder self-host, đa ngôn ngữ (CV tiếng Việt)
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# LangSmith — tracing + eval dataset. Lấy API key tại https://smith.langchain.com/settings
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=cv-rag-ai